# OminiPulse Mobile App — Environment
# Copy to .env and fill in your Supabase project credentials (Dashboard → Settings → API)

# Unified backend (database + auth) — shared with web/desktop app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: legacy REST API base URL (leave unset to use Supabase + mock fallback)
# EXPO_PUBLIC_API_URL=https://api.ominipulse.health/v1
