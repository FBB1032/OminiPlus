# OminiPulse Backend (Express.js) — Environment
# Copy to backend/.env and fill in. NEVER commit backend/.env.

# ─── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ─── Supabase (required) ──────────────────────────────────────────────────
# Same project the mobile/web apps use. URL + anon key are in the Supabase
# dashboard → Settings → API. The service-role key MUST stay server-side.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated origins, or * to allow all (dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ─── Rate limits ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ─── AI engine (provider chain: Groq → Gemini → OpenAI) ───────────────────
# Groq is the primary: free tier, ~fastest inference, Llama 3.3 70B quality.
# Get a key at https://console.groq.com (free).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback 1: Google AI Studio free tier (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback 2: paid safety net (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── AI limits ───────────────────────────────────────────────────────────
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=30000
AI_DAILY_USER_CAP=30
