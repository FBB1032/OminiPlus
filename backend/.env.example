# OminiPulse Backend (Express.js) — Environment
# Copy to backend/.env and fill in. NEVER commit backend/.env.

# ─── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ─── Supabase (required) ──────────────────────────────────────────────────
# Same project the mobile/web apps use. URL + anon key are in the Supabase
# dashboard → Settings → API. The service-role key MUST stay server-side.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated origins, or * to allow all (dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ─── Rate limits ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# ─── AI engine (Groq model chain with automatic failover) ──────────────────
# Groq-only: if the primary model errors (decommissioned, 429/503 capacity,
# timeout), the backend automatically retries with each fallback model in
# order on the same key. Get a free key at https://console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,groq/compound-mini,allam-2-7b
# Optional: override the API base URL (self-hosted proxy etc.)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── AI limits ───────────────────────────────────────────────────────────
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=30000
AI_DAILY_USER_CAP=30
