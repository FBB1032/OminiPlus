{
  "name": "ominipulse-desktop",
  "version": "2.2.0",
  "description": "OminiPulse Professional Clinical Desktop Application for Doctors, Hospitals, and Platform Administrators",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "desktop": "npm run electron:dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.js",
    "start": "next start -p 3005",
    "lint": "eslint",
    "electron": "electron .",
    "electron:dev": "concurrently -k -s first \"next dev -p 3005\" \"wait-on tcp:3005 && cross-env ELECTRON_DEV_URL=http://localhost:3005 electron .\"",
    "electron:pack": "next build && node scripts/copy-standalone-assets.js && electron-builder --dir",
    "electron:dist": "next build && node scripts/copy-standalone-assets.js && electron-builder"
  },
  "build": {
    "appId": "ai.ominipulse.desktop",
    "productName": "OminiPulse Desktop",
    "copyright": "Copyright © 2026 OminiPulse Health Inc.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "public/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-standalone"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/favicon.png",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/favicon.png",
      "category": "Medical"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.101.0",
    "@supabase/supabase-js": "^2.58.0",
    "@types/three": "^0.185.4",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.2"
  }
}
